# Phanilie Music Platform - Environment Variables Template

# Backend API Configuration
ASPNETCORE_ENVIRONMENT=Development
PORT=5013

# Database Connection (Neon PostgreSQL)
DB_HOST=ep-sample-123456.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_neon_password

# Authentication (JWT)
JWT_SECRET=YourSuperSecretJwtKeyWithMinimum32CharactersLengthForSecurity!
JWT_ISSUER=PhaniliePlatform
JWT_AUDIENCE=PhanilieUsers

# Payment Gateways (Midtrans & Stripe)
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXX
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXX
STRIPE_SECRET_KEY=sk_test_XXXXX

# Media & Storage Provider
STORAGE_PROVIDER=Local # Options: Local | Cloud
CLOUD_STORAGE_URL=https://storage.phanilie.com
CLOUD_STORAGE_API_KEY=your_cloud_storage_api_key
