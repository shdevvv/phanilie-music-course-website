# Phanilie Music Platform - Environment Variables Template

# Backend API Configuration
ASPNETCORE_ENVIRONMENT=Development
PORT=5013

# Database Connection (Supabase PostgreSQL)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_database_password

# Authentication (JWT)
JWT_SECRET=YourSuperSecretJwtKeyWithMinimum32CharactersLengthForSecurity!
JWT_ISSUER=PhaniliePlatform
JWT_AUDIENCE=PhanilieUsers

# Payment Gateways (Midtrans & Stripe)
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXX
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXX
STRIPE_SECRET_KEY=sk_test_XXXXX

# Media & Storage Provider
STORAGE_PROVIDER=Local # Options: Local | Supabase
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
